# ==============================================================================
# AI BY FARAZ — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Public Site URL (Used for Canonical SEO, OpenGraph & Schema.org)
NEXT_PUBLIC_APP_URL=https://www.aibyfaraz.com

# [TODO: GOOGLE SEARCH CONSOLE] Optional env var for site verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# ------------------------------------------------------------------------------
# 2. CONVERSATIONAL AI CHATBOT PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider-Independent Architecture: Choose your preferred LLM provider.
# Options: "gemini" | "openai" | "anthropic" | "fallback"
# If unset, the system auto-detects by key presence (Gemini -> OpenAI -> Anthropic -> Fallback).
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended for speed & low cost: gemini-1.5-flash / gemini-2.0-flash)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional alternative: gpt-4o-mini)
# Get your key at: https://platform.openai.com/
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key (Optional alternative: claude-3-5-haiku-20241022)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# 3. CHATBOT ADMIN MANAGEMENT CONSOLE
# ------------------------------------------------------------------------------
# Passcode required to view captured leads and analytics at /admin/chatbot
ADMIN_SECRET_KEY=faraz-ai-admin-2026

# ------------------------------------------------------------------------------
# 4. SUPABASE BACKEND CONFIGURATION (PostgreSQL & Encrypted Storage Vault)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_jwt_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Direct Database URLs (Session pooler & direct IPv6)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 5. INSTANT EMAIL NOTIFICATIONS (Resend API)
# ------------------------------------------------------------------------------
# Triggers instant email alerts to Faraz whenever a new hot lead is captured in chat.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=AI by Faraz <onboarding@resend.dev>
EMAIL_TO=faraz.ahmed4723@gmail.com

# ------------------------------------------------------------------------------
# 6. FIREBASE AUTHENTICATION (Optional Admin / Client Portal)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
